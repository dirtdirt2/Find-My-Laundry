# App
NODE_ENV=development
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Local MySQL connection (MySQL Server must be running)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_this_local_password
DB_NAME=find_my_laundry
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Generate a random value of at least 32 characters for each environment.
# Example (PowerShell): [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
OTP_HASH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=Find My Laundry <your-gmail@gmail.com>
